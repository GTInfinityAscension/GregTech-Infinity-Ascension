	quests: [
		{
			description: [
				"Read this chapter as a table. Each row is an era of the game and opens when you reach that era's chapter. Each column is one way of making energy."
				""
				"Across a row: what you can build right now, and how the options compare. Down a column: how one family grows. The cards on top list each generator's fuels with the EU one bucket gives, taken from this pack's recipes."
			]
			icon: "gtceu:lv_steam_turbine"
			id: "44A46278A3F8D21A"
			rewards: [ ]
			shape: "gear"
			size: 2.0d
			subtitle: "Every way to make EU, side by side."
			tasks: [
				{
					id: "67355657F668B969"
					type: "checkmark"
					title: "Begin"
				}
			]
			title: "Power Generation"
			x: -2.5d
			y: 0.0d
		}
		{
			dependencies: [
				"777C50D80E2DDE50"
			]
			description: [
